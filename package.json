{
    "name": "@ax-design/scroll",
    "version": "0.2.1",
    "description": "Web component that implements the horizontal scroller of Axiom Design System: vertical wheels, touchpads and keys scroll it sideways, like the Windows 8 Start screen.",
    "main": "build/main.js",
    "module": "es/index.js",
    "typings": "es/index.d.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ax-design/scroll.git"
    },
    "license": "MIT",
    "sideEffects": false,
    "devDependencies": {
        "@ax-design/reveal-highlight": "^0.7.2",
        "@ax-design/tile-group": "^0.2.4",
        "@fluentui/svg-icons": "1.1.344",
        "@types/bun": "latest",
        "playwright": "^1.64.0",
        "typescript": "^5.6.0"
    },
    "scripts": {
        "build": "bun scripts/build.ts",
        "check": "tsc -p tsconfig.json --noEmit",
        "test": "bun test",
        "test:browser": "bun test-browser/run.ts",
        "demo": "bun demo/serve.ts",
        "prepublishOnly": "bun run build"
    },
    "homepage": "https://github.com/ax-design/scroll#readme",
    "bugs": {
        "url": "https://github.com/ax-design/scroll/issues"
    },
    "files": [
        "build",
        "es",
        "src"
    ],
    "exports": {
        ".": {
            "types": "./es/index.d.ts",
            "source": "./src/index.ts",
            "import": "./es/index.js",
            "require": "./build/main.js",
            "default": "./es/index.js"
        },
        "./package.json": "./package.json"
    }
}
